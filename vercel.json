{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/product/:id", "destination": "/product.html?id=:id" }
  ],
  "redirects": [
    { "source": "/signature-collection", "destination": "/crown-collection.html", "permanent": true },
    { "source": "/collections", "destination": "/crown-collection.html", "permanent": true },
    { "source": "/signature-collection.html", "destination": "/crown-collection.html", "permanent": true },
    { "source": "/collections.html", "destination": "/crown-collection.html", "permanent": true },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "maharani-cascade" }],
      "destination": "/house-of-diamonds/maharani-cascade/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "emerald-reverie" }],
      "destination": "/emerald-court/emerald-reverie/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "imperial-dominion" }],
      "destination": "/crown-collection/imperial-dominion/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "royal-edict" }],
      "destination": "/crown-collection/royal-edict/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "regalia-canopy" }],
      "destination": "/crown-collection/regalia-canopy/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "ruby-aurora" }],
      "destination": "/ruby-salon/ruby-aurora/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "ceremonial-bloom" }],
      "destination": "/heritage-atelier/ceremonial-bloom/",
      "permanent": true
    },
    {
      "source": "/house-piece.html",
      "has": [{ "type": "query", "key": "id", "value": "morning-dew" }],
      "destination": "/jasmine-atelier/morning-dew/",
      "permanent": true
    }
  ],
  "functions": {
    "api/oauth.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://*.googleapis.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://images.unsplash.com data:; media-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.googleapis.com https://api.github.com; frame-src 'self' https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
